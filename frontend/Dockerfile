FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json ./
RUN npm install

FROM node:20-alpine AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=https://api.logisticopilot.com
ARG NEXT_PUBLIC_SITE_URL=https://logisticopilot.com
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID=G-NTGQ0PGRW3
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ARG NEXT_PUBLIC_CHROME_EXTENSION_ID=cgjgjfdnbdaahgmnalcjkockkogijhfj
ARG NEXT_PUBLIC_TURNSTILE_THEME=light
ARG NEXT_PUBLIC_TURNSTILE_LANGUAGE=en
ARG NEXT_PUBLIC_TURNSTILE_SIZE=flexible
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=${NEXT_PUBLIC_GA_MEASUREMENT_ID}
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=${NEXT_PUBLIC_TURNSTILE_SITE_KEY}
ENV NEXT_PUBLIC_TURNSTILE_THEME=${NEXT_PUBLIC_TURNSTILE_THEME}
ENV NEXT_PUBLIC_TURNSTILE_LANGUAGE=${NEXT_PUBLIC_TURNSTILE_LANGUAGE}
ENV NEXT_PUBLIC_TURNSTILE_SIZE=${NEXT_PUBLIC_TURNSTILE_SIZE}
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

EXPOSE 3000
CMD ["node", "server.js"]
