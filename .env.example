# ===================================================
# AI Agent — Environment Variables
# Copy to .env and fill in your values
# ===================================================

# --- LLM Providers ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Primary model ---
PRIMARY_MODEL=claude-sonnet-4-20250514
FALLBACK_MODEL=gpt-4o-mini

# --- Qdrant (Vector Memory) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=agent_memory

# --- PostgreSQL (Structured Data) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_db
POSTGRES_USER=agent
POSTGRES_PASSWORD=changeme_in_production

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LangSmith (Observability) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=ai-agent

# --- Security ---
API_SECRET_KEY=changeme_generate_a_random_key

# --- Microsoft Graph / Outlook ---
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_MAILBOX=broker@example.com
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# --- TMS ---
TMS_BASE_URL=https://your-tms.example.com/api
TMS_API_KEY=replace-me
TMS_TIMEOUT_SECONDS=30

# --- Freight Workflow Defaults ---
QUOTE_WAIT_MINUTES_DEFAULT=20
PROFIT_MARGIN_PERCENT_DEFAULT=15
PROFIT_MARGIN_FLOOR_DEFAULT=0
