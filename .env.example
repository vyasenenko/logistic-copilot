# ============================================================
# Logistic Copilot - Environment Variables
# Copy this file to `.env` and fill values for your environment.
#
# Recommended workflow:
#   make env-init
#   make env-check
#   make env-set KEY=API_SECRET_KEY VALUE="$(openssl rand -hex 32)"
#
# Priority guide used by scripts/check_env.py:
#   P0 - required for security, data integrity, or production readiness.
#   P1 - required for core product workflows.
#   P2 - feature/integration configuration.
#   P3 - local ports, diagnostics, tuning, and optional behavior.
#
# Metadata comments supported by scripts/check_env.py:
#   @required true       Empty value is an error.
#   @prod_required true  Empty/default value is production-urgent.
#   @secret true         Value is sensitive and must never be committed.
#   @allowed_empty true  Empty value is acceptable.
#   @example value       Human-readable example for handoff.
#
# Values:
#   Booleans use true/false. Lists are comma-separated. Do not wrap values
#   in quotes unless the value itself requires quoting in your shell.
# ============================================================

# ============================================================
# P0 - Security and bootstrap
# ============================================================

# Main backend secret used for auth/session signing and internal trust boundaries.
# Production: use a unique random value, for example `openssl rand -hex 32`.
# @required true
# @prod_required true
# @secret true
API_SECRET_KEY=changeme_generate_a_random_key

# Enable backend auth checks. Keep true except for very narrow local debugging.
# @required true
AUTH_ENFORCE=true

# Require Cloudflare Turnstile on login/invite forms.
# Local handoff can keep this false; production should normally use true.
# @required true
AUTH_REQUIRE_TURNSTILE=false

# Cloudflare Turnstile secret key. Required only when AUTH_REQUIRE_TURNSTILE=true.
# @secret true
# @allowed_empty true
TURNSTILE_SECRET_KEY=

# Cloudflare verification endpoint.
# @required true
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Initial owner account created on first startup when the database is empty.
# @required true
BOOTSTRAP_OWNER_EMAIL=owner@example.com

# Initial owner password. Leave empty to create the user without password login.
# Set for handoff demos if the receiver needs immediate login access.
# @secret true
# @allowed_empty true
BOOTSTRAP_OWNER_PASSWORD=

# Display name for the initial owner.
# @required true
BOOTSTRAP_OWNER_NAME=Logistic Copilot Owner

# Initial organization name.
# @required true
BOOTSTRAP_ORGANIZATION_NAME=Logistic Copilot

# Initial organization email domain. Used by invite/member role guardrails.
# @required true
BOOTSTRAP_ORGANIZATION_DOMAIN=example.com

# Optional mailbox used as the initial Outlook mailbox hint.
# @allowed_empty true
BOOTSTRAP_OUTLOOK_MAILBOX=

# ============================================================
# P0 - Database and storage
# ============================================================

# PostgreSQL host. Docker Compose overrides this to `postgres` for the backend container.
# @required true
POSTGRES_HOST=localhost

# PostgreSQL port.
# @required true
POSTGRES_PORT=5432

# PostgreSQL database name.
# @required true
POSTGRES_DB=agent_db

# PostgreSQL user.
# @required true
POSTGRES_USER=agent

# PostgreSQL password.
# @required true
# @prod_required true
# @dev_placeholder_ok true
# @secret true
POSTGRES_PASSWORD=changeme_in_production

# Enable TLS for managed PostgreSQL providers.
# @required true
POSTGRES_SSL=false

# Optional CA bundle path for verified PostgreSQL TLS.
# @allowed_empty true
POSTGRES_SSL_CA_FILE=

# Skip PostgreSQL certificate verification while still using TLS.
# Prefer POSTGRES_SSL_CA_FILE in production.
# @required true
POSTGRES_SSL_SKIP_VERIFY=false

# S3-compatible storage endpoint. Docker Compose uses MinIO at http://minio:9000.
# @required true
S3_ENDPOINT_URL=http://minio:9000

# S3 access key.
# @required true
# @secret true
S3_ACCESS_KEY=minioadmin

# S3 secret key.
# @required true
# @secret true
S3_SECRET_KEY=minioadmin

# S3 bucket for uploaded/generated content.
# @required true
S3_BUCKET=agent-content

# Public base URL for stored files.
# @required true
S3_PUBLIC_URL=http://localhost:9000/agent-content

# ============================================================
# P1 - LLM providers and routing
# ============================================================

# Provider order for AI calls. Supported values: deepseek, openai, anthropic.
# @required true
LLM_PROVIDER_ORDER=deepseek,openai,anthropic

# DeepSeek API key. Current preferred primary provider.
# @secret true
# @allowed_empty true
DEEPSEEK_API_KEY=

# DeepSeek OpenAI-compatible base URL.
# @required true
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek model name.
# @required true
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API key. Used for fallback, audio transcription, and OpenAI vision OCR.
# @secret true
# @allowed_empty true
OPENAI_API_KEY=

# OpenAI model for fallback and OCR-related tasks.
# @required true
OPENAI_MODEL=gpt-4o-mini

# Anthropic API key. Used as fallback and Anthropic document OCR path.
# @secret true
# @allowed_empty true
ANTHROPIC_API_KEY=

# Anthropic model for fallback and OCR-related tasks.
# @required true
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Legacy primary model name kept for backwards-compatible code paths.
# @required true
PRIMARY_MODEL=claude-sonnet-4-20250514

# Legacy fallback model name kept for backwards-compatible code paths.
# @required true
FALLBACK_MODEL=gpt-4o-mini

# LLM temperature for deterministic freight parsing and workflow decisions.
# @required true
LLM_TEMPERATURE=0.1

# Max tokens for primary LLM calls.
# @required true
LLM_PRIMARY_MAX_TOKENS=8192

# Max tokens for fallback LLM calls.
# @required true
LLM_FALLBACK_MAX_TOKENS=4096

# ============================================================
# P1 - Backend, frontend, and auth URLs
# ============================================================

# Backend bind host.
# @required true
BACKEND_HOST=0.0.0.0

# Backend internal port.
# @required true
BACKEND_PORT=8000

# Allowed browser origins for backend CORS.
# Add deployed frontend URLs and trusted extension origins when needed.
# @required true
BACKEND_CORS_ORIGINS=http://localhost:3000

# Development-only helper: allow any chrome-extension:// origin.
# Set false for production-like environments.
# @required true
CORS_ALLOW_CHROME_EXTENSIONS=true

# Public frontend URL used in invite emails and links.
# @required true
PUBLIC_APP_BASE_URL=http://localhost:3000

# Public API URL baked into the Next.js frontend build.
# @required true
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Analytics 4 measurement ID for landing/product analytics.
# Create a GA4 web stream and paste a value like G-XXXXXXXXXX.
# @allowed_empty true
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Chrome extension ID for an additional logout sync path.
# @allowed_empty true
NEXT_PUBLIC_CHROME_EXTENSION_ID=

# Cloudflare Turnstile site key used by frontend login/invite forms.
# Required only when AUTH_REQUIRE_TURNSTILE=true.
# @allowed_empty true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Turnstile widget theme: light, dark, or auto.
# @required true
NEXT_PUBLIC_TURNSTILE_THEME=light

# Turnstile widget language, for example en or auto.
# @required true
NEXT_PUBLIC_TURNSTILE_LANGUAGE=en

# Turnstile widget size: normal, flexible, or compact.
# @required true
NEXT_PUBLIC_TURNSTILE_SIZE=flexible

# ============================================================
# P1 - Microsoft Graph / Outlook
# ============================================================

# Fernet key used to encrypt organization-level Outlook credentials in DB.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# @prod_required true
# @secret true
# @allowed_empty true
OUTLOOK_CREDENTIALS_FERNET_KEY=

# Optional separate signing secret for Graph webhook clientState.
# Defaults to API_SECRET_KEY if empty.
# @secret true
# @allowed_empty true
OUTLOOK_WEBHOOK_STATE_SECRET=

# Microsoft Graph base URL.
# @required true
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Public HTTPS backend base URL used to build /api/freight/outlook/webhook.
# Required for real Graph webhooks; manual local sync can leave it empty.
# @allowed_empty true
MICROSOFT_WEBHOOK_PUBLIC_BASE_URL=

# Legacy static Graph webhook clientState. Prefer signed state via OUTLOOK_WEBHOOK_STATE_SECRET.
# @secret true
# @allowed_empty true
MICROSOFT_WEBHOOK_CLIENT_STATE=

# Outlook change type for subscriptions.
# @required true
MICROSOFT_WEBHOOK_CHANGE_TYPE=created

# Optional legacy/static Graph resource override.
# @allowed_empty true
MICROSOFT_WEBHOOK_RESOURCE=

# Delay webhook bootstrap after app startup to avoid validation races.
# @required true
MICROSOFT_WEBHOOK_STARTUP_DELAY_SECONDS=8

# Background webhook renewal interval.
# @required true
MICROSOFT_WEBHOOK_RENEW_INTERVAL_SECONDS=43200

# Renewal buffer window in minutes.
# @required true
MICROSOFT_WEBHOOK_RENEWAL_BUFFER_MINUTES=2880

# Requested subscription expiration in minutes.
# @required true
MICROSOFT_WEBHOOK_EXPIRATION_MINUTES=10070

# Legacy static Outlook credentials. Runtime credentials are stored per organization in DB.
# Keep empty unless intentionally migrating old values.
# @secret true
# @allowed_empty true
MICROSOFT_TENANT_ID=

# @secret true
# @allowed_empty true
MICROSOFT_CLIENT_ID=

# @secret true
# @allowed_empty true
MICROSOFT_CLIENT_SECRET=

# @allowed_empty true
MICROSOFT_MAILBOX=

# ============================================================
# P1 - Freight workflow defaults
# ============================================================

# Default carrier bid wait window after outreach, in minutes.
# @required true
QUOTE_WAIT_MINUTES_DEFAULT=20

# Background interval for checking quote windows.
# @required true
QUOTE_WINDOW_CHECK_INTERVAL_SECONDS=60

# Default markup percent applied to selected carrier bid.
# @required true
PROFIT_MARGIN_PERCENT_DEFAULT=15

# Minimum markup floor amount.
# @required true
PROFIT_MARGIN_FLOOR_DEFAULT=0

# Status freshness SLA in hours.
# @required true
STATUS_SLA_HOURS_DEFAULT=24

# Document-aware booking policy: warning_only, review_required, or block_booking.
# @required true
DOCUMENT_BOOKING_POLICY_DEFAULT=review_required

# ============================================================
# P1 - Document OCR
# ============================================================

# OCR provider order. Supported values: openai, anthropic.
# @required true
DOCUMENT_OCR_PROVIDER_ORDER=openai,anthropic

# OCR provider timeout in seconds.
# @required true
DOCUMENT_OCR_TIMEOUT_SECONDS=45

# Minimum OCR confidence before review is required.
# @required true
DOCUMENT_MIN_OCR_CONFIDENCE=0.55

# Minimum field extraction confidence before review is required.
# @required true
DOCUMENT_MIN_FIELD_CONFIDENCE=0.6

# ============================================================
# P2 - TMS integration
# ============================================================

# Base URL for the configured TMS API.
# Leave empty until the customer TMS is selected.
# @allowed_empty true
TMS_BASE_URL=

# API key/token for the configured TMS.
# @secret true
# @allowed_empty true
TMS_API_KEY=

# TMS request timeout in seconds.
# @required true
TMS_TIMEOUT_SECONDS=30

# TMS retry attempts after the first request.
# @required true
TMS_RETRY_ATTEMPTS=2

# ============================================================
# P2 - Transactional email
# ============================================================

# Resend API key for invite emails.
# @secret true
# @allowed_empty true
RESEND_API_KEY=

# From address for invite emails, for example Logistic Copilot <noreply@example.com>.
# @allowed_empty true
RESEND_FROM_EMAIL=

# ============================================================
# P2 - Qdrant vector memory
# ============================================================

# Qdrant host. Docker Compose overrides this to `qdrant` for the backend container.
# @required true
QDRANT_HOST=localhost

# Qdrant HTTP port.
# @required true
QDRANT_PORT=6333

# Qdrant collection for long-term agent memory.
# @required true
QDRANT_COLLECTION=agent_memory

# ============================================================
# P2 - LangSmith observability
# ============================================================

# Enable LangChain/LangGraph tracing.
# @required true
LANGCHAIN_TRACING_V2=true

# LangSmith API key.
# @secret true
# @allowed_empty true
LANGCHAIN_API_KEY=

# LangSmith project name.
# @required true
LANGCHAIN_PROJECT=logistic-copilot

# ============================================================
# P3 - Docker Compose host ports
# ============================================================

# Host port mapped to backend container port 8000.
# @required true
BACKEND_HTTP_PORT=8000

# Host port mapped to frontend container port 3000.
# @required true
FRONTEND_HTTP_PORT=3000

# Host port mapped to PostgreSQL container port 5432.
# @required true
POSTGRES_PUBLISH_PORT=5432

# Host port mapped to Qdrant HTTP.
# @required true
QDRANT_HTTP_PORT=6333

# Host port mapped to Qdrant gRPC.
# @required true
QDRANT_GRPC_PORT=6334

# Host port mapped to MinIO API.
# @required true
MINIO_API_PORT=9000

# Host port mapped to MinIO console.
# @required true
MINIO_CONSOLE_PORT=9001
