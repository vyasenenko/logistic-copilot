# ===================================================
# AI Agent — Environment Variables
# Copy to .env and fill in your values
# ===================================================

# --- LLM Providers ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- LLM routing / models ---
LLM_PROVIDER_ORDER=deepseek,openai,anthropic
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.1
LLM_PRIMARY_MAX_TOKENS=8192
LLM_FALLBACK_MAX_TOKENS=4096

# --- Legacy model keys (kept for backwards compatibility) ---
PRIMARY_MODEL=claude-sonnet-4-20250514
FALLBACK_MODEL=gpt-4o-mini

# --- Document OCR ---
DOCUMENT_OCR_PROVIDER_ORDER=openai,anthropic
DOCUMENT_OCR_TIMEOUT_SECONDS=45
DOCUMENT_MIN_OCR_CONFIDENCE=0.55
DOCUMENT_MIN_FIELD_CONFIDENCE=0.6

# --- Qdrant (Vector Memory) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=agent_memory

# --- Docker Compose: host ports (if "Bind ... failed: port is already allocated") ---
# Example: QDRANT_HTTP_PORT=6335 then set QDRANT_PORT=6335 here only when backend runs on the host (not in compose).
# Qdrant: host -> container 6333/6334; backend in compose always uses qdrant:6333 inside the network
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Backend on host: if 8000 is busy use e.g. 8001 — compose sets NEXT_PUBLIC_API_URL + CORS to match FRONTEND_HTTP_PORT
BACKEND_HTTP_PORT=8000
FRONTEND_HTTP_PORT=3000
POSTGRES_PUBLISH_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL (Structured Data) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_db
POSTGRES_USER=agent
POSTGRES_PASSWORD=changeme_in_production

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- LangSmith (Observability) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=ai-agent

# --- Security ---
API_SECRET_KEY=changeme_generate_a_random_key

# --- Microsoft Graph / Outlook (app-only / client_credentials) ---
# Azure: App registration → API permissions → Microsoft Graph → APPLICATION (not Delegated):
#   Mail.Read (or Mail.ReadWrite), User.Read.All if you resolve users by UPN — then Grant admin consent.
# If Graph returns 403 after that: Exchange Online "application access policies" may block the app for this mailbox.
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
MICROSOFT_MAILBOX=broker@example.com
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# Webhook (optional): set ONLY when you have a public HTTPS URL that forwards to backend /api/freight/outlook/webhook
# If unset, startup skips webhook subscription bootstrap.
MICROSOFT_WEBHOOK_PUBLIC_BASE_URL=
MICROSOFT_WEBHOOK_CLIENT_STATE=logistic-copilot-outlook-webhook
# Optional override; defaults to users/{MICROSOFT_MAILBOX}/mailFolders('Inbox')/messages
MICROSOFT_WEBHOOK_RESOURCE=
# Delay webhook bootstrap after app startup (helps avoid Graph validation race on cold start)
MICROSOFT_WEBHOOK_STARTUP_DELAY_SECONDS=8

# --- TMS ---
TMS_BASE_URL=https://your-tms.example.com/api
TMS_API_KEY=replace-me
TMS_TIMEOUT_SECONDS=30

# --- Freight Workflow Defaults ---
QUOTE_WAIT_MINUTES_DEFAULT=20
PROFIT_MARGIN_PERCENT_DEFAULT=15
PROFIT_MARGIN_FLOOR_DEFAULT=0
