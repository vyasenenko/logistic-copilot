# ===================================================
# AI Agent — Environment Variables
# Copy to .env and fill in your values
# ===================================================

# --- LLM Providers ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- LLM routing / models ---
LLM_PROVIDER_ORDER=deepseek,openai,anthropic
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.1
LLM_PRIMARY_MAX_TOKENS=8192
LLM_FALLBACK_MAX_TOKENS=4096

# --- Legacy model keys (kept for backwards compatibility) ---
PRIMARY_MODEL=claude-sonnet-4-20250514
FALLBACK_MODEL=gpt-4o-mini

# --- Document OCR ---
DOCUMENT_OCR_PROVIDER_ORDER=openai,anthropic
DOCUMENT_OCR_TIMEOUT_SECONDS=45
DOCUMENT_MIN_OCR_CONFIDENCE=0.55
DOCUMENT_MIN_FIELD_CONFIDENCE=0.6

# --- Qdrant (Vector Memory) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=agent_memory

# --- Docker Compose: host ports (if "Bind ... failed: port is already allocated") ---
# Example: QDRANT_HTTP_PORT=6335 then set QDRANT_PORT=6335 here only when backend runs on the host (not in compose).
# Qdrant: host -> container 6333/6334; backend in compose always uses qdrant:6333 inside the network
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Backend on host: if 8000 is busy use e.g. 8001 — compose sets NEXT_PUBLIC_API_URL + CORS to match FRONTEND_HTTP_PORT
BACKEND_HTTP_PORT=8000
FRONTEND_HTTP_PORT=3000
POSTGRES_PUBLISH_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- PostgreSQL (Structured Data) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_db
POSTGRES_USER=agent
POSTGRES_PASSWORD=changeme_in_production
# DigitalOcean Managed Postgres and many clouds require TLS (asyncpg).
POSTGRES_SSL=false
# Only if TLS is on and you cannot use POSTGRES_SSL_CA_FILE (not recommended for production).
POSTGRES_SSL_SKIP_VERIFY=false

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
# Optional: comma-separated origins — add chrome-extension://YOUR_EXTENSION_ID (chrome://extensions)
# or your public/tunnel frontend URL (https://…) if the browser Origin must match.
# Docker Compose: BACKEND_CORS_ORIGINS is no longer overwritten by compose; set it here.
# Dev-only (insecure for production): allow any Chrome extension origin (docker-compose defaults this to true)
# CORS_ALLOW_CHROME_EXTENSIONS=true

# --- Frontend ---
# Make k8s-buildx-frontend / k8s-buildx-all: reads NEXT_PUBLIC_* (API URL, Turnstile site key, theme, language, size), TAG, PLATFORM, DOCKER_REGISTRY from K8S_BUILD_ENV (default: root .env). Override: K8S_BUILD_ENV=./prod.env make k8s-buildx-frontend. Command-line VAR=... still wins over .env.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: extension ID for a second chrome.runtime.sendMessage path; primary sync uses a content-script postMessage bridge (reload extension after manifest changes).
# NEXT_PUBLIC_CHROME_EXTENSION_ID=
# Cloudflare Turnstile widget (public site key). Local dev: set here; production Docker image: pass as build-arg (see frontend/Dockerfile, make k8s-buildx-frontend).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: light | dark | auto (default light)
NEXT_PUBLIC_TURNSTILE_THEME=light
# Optional: auto (browser), en, ru, ...
NEXT_PUBLIC_TURNSTILE_LANGUAGE=en
# Optional: normal | flexible | compact
NEXT_PUBLIC_TURNSTILE_SIZE=flexible

# --- LangSmith (Observability) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=ai-agent

# --- Security ---
API_SECRET_KEY=changeme_generate_a_random_key
AUTH_REQUIRE_TURNSTILE=false
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
BOOTSTRAP_OWNER_EMAIL=vyasenenko@logisticopilot.com
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=Vitalii Yasenenko
BOOTSTRAP_ORGANIZATION_NAME=Logistic Copilot
BOOTSTRAP_ORGANIZATION_DOMAIN=logisticopilot.com
BOOTSTRAP_OUTLOOK_MAILBOX=

# --- Transactional email (Resend) ---
# Create API key at https://resend.com — verify your sending domain so From matches it.
RESEND_API_KEY=
# Example: Logistic Copilot <noreply@mail.yourdomain.com>
RESEND_FROM_EMAIL=
# Frontend base URL with no trailing slash (invite emails link to PUBLIC_APP_BASE_URL/invite?token=...)
PUBLIC_APP_BASE_URL=http://localhost:3000

# --- Microsoft Graph / Outlook ---
# Tenant ID, client ID, client secret, and mailbox are stored per organization in the app DB
# (/settings in the dashboard, or PUT /api/organizations/current/outlook-credentials).
# Generate a Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OUTLOOK_CREDENTIALS_FERNET_KEY=
# Optional separate secret for signing Graph webhook clientState (defaults to API_SECRET_KEY)
OUTLOOK_WEBHOOK_STATE_SECRET=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# Legacy env vars (not used at runtime for Graph auth; migrate values into org settings in DB):
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_MAILBOX=
# Webhook: single public HTTPS URL for all orgs → backend /api/freight/outlook/webhook
MICROSOFT_WEBHOOK_PUBLIC_BASE_URL=
MICROSOFT_WEBHOOK_CLIENT_STATE=
MICROSOFT_WEBHOOK_RESOURCE=
# Delay webhook bootstrap after app startup (helps avoid Graph validation race on cold start)
MICROSOFT_WEBHOOK_STARTUP_DELAY_SECONDS=8

# --- TMS ---
TMS_BASE_URL=https://your-tms.example.com/api
TMS_API_KEY=replace-me
TMS_TIMEOUT_SECONDS=30

# --- Freight Workflow Defaults ---
QUOTE_WAIT_MINUTES_DEFAULT=20
QUOTE_WINDOW_CHECK_INTERVAL_SECONDS=60
PROFIT_MARGIN_PERCENT_DEFAULT=15
PROFIT_MARGIN_FLOOR_DEFAULT=0
